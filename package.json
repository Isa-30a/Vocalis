{
  "name": "vocalis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:next": "next dev",
    "dev:vinext": "vite dev --port 3001",
    "build": "vite build",
    "build:next": "next build",
    "build:vinext": "vite build",
    "start": "vite preview",
    "start:next": "next start",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "lint": "eslint",
    "typecheck": "next typegen && cf workers types && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local": "node db/local.ts",
    "db:migrate": "cf d1 migrations apply ${D1_DATABASE_ID:?set D1_DATABASE_ID} --dir drizzle",
    "db:seed:generate": "node db/seed/build.ts",
    "db:seed": "node db/seed/apply.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@vinext/cloudflare": "^1.3.2",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.27",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module"
}
